# Set these environment variables in your shell; the app does not auto-load .env.
# Local Ollama: run `ollama pull qwen2.5:7b`, then `ollama serve`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Optional provider rates. Omit for local inference; electricity is not measured.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Optional dense retrieval (requires requirements-dense.txt and a model download).
USE_DENSE_EMBEDDINGS=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
